#!/usr/bin/env bashio
# shellcheck shell=bash

declare APP_EXIT_CODE=${1}

if [[ "${APP_EXIT_CODE}" -ne 0 ]] && [[ "${APP_EXIT_CODE}" -ne 256 ]]; then
    # The TTS gateway is optional; a crash must not take the chat down,
    # s6 restarts the service
    bashio::log.warning "TTS gateway exited with code ${APP_EXIT_CODE}; speech output is unavailable until it restarts"
fi

bashio::log.info "TTS gateway stopped, restarting..."
