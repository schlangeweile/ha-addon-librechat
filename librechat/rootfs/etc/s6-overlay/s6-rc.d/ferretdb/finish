#!/usr/bin/env bashio
# shellcheck shell=bash

declare APP_EXIT_CODE=${1}

if [[ "${APP_EXIT_CODE}" -ne 0 ]] && [[ "${APP_EXIT_CODE}" -ne 256 ]]; then
    bashio::log.warning "FerretDB exited with code ${APP_EXIT_CODE}"
    bashio::log.warning "Halting add-on in 60 seconds..."
    sleep 60
    /run/s6/basedir/bin/halt
fi

bashio::log.info "FerretDB stopped normally, restarting..."
